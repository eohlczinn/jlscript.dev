# JLAI
JLAI_HOST=127.0.0.1
JLAI_PORT=8765
JLAI_ENV=development

# CORS. Separe origens por vírgula.
JLAI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://jlscript-oficial.lucasaguiel5.workers.dev

# Site e documentação
JLAI_SITE_URL=https://jlscript-oficial.lucasaguiel5.workers.dev
JLAI_DOCS_URL=https://jlscript-oficial.lucasaguiel5.workers.dev/#/docs
JLAI_PUBLIC_DOCS_URL=https://github.com/JLScripter/documentacao_JLScripter

# Contato opcional. Deixe vazio para direcionar à página Suporte.
JLAI_SUPPORT_EMAIL=

# Experiência de chat
JLAI_MIN_THINK_MS=420
JLAI_MAX_THINK_MS=950
JLAI_STREAM_CHUNK_MIN=3
JLAI_STREAM_CHUNK_MAX=10
JLAI_STREAM_DELAY_MIN_MS=8
JLAI_STREAM_DELAY_MAX_MS=24

# Limites simples
JLAI_MAX_QUESTION_CHARS=5000
JLAI_RATE_LIMIT_PER_MINUTE=40
