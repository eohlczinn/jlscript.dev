{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jlscript-oficial",
  "compatibility_date": "2026-10-04",

  "workers_dev": true,

  "observability": {
    "enabled": true,
  },

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
